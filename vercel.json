{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "npm ci --include=dev --no-fund && npm run build",
  "regions": ["icn1"],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"},
      {"key":"Cache-Control","value":"no-cache"}
    ]
  }, {
    "source": "/api/(.*)",
    "headers": [{"key":"Cache-Control","value":"no-store"}]
  }, {
    "source": "/assets/:file([A-Za-z0-9_-]+-[A-Za-z0-9_-]{8}\\.(?:js|css))",
    "headers": [{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]
  }],
  "functions": {
    "app.py": { "maxDuration": 120, "excludeFiles": "node_modules/**" }
  }
}
